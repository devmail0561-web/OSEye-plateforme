# OSEye Server — SECRETS Configuration
# Copy to /etc/oseye/secrets.env  (chmod 600, owner root)
# NEVER commit this file with real values.
# In production, consider a secrets manager (Vault, AWS Secrets Manager, etc.)

# ── Authentication (REQUIRED) ────────────────────────────────────────────────
# Must differ from dev defaults ('admin123' / 'analyst123').
# The server REFUSES to start in production if weak defaults are used.
OSEYE_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
OSEYE_ANALYST_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Database password ─────────────────────────────────────────────────────────
# Must match the password in OSEYE_DB_URL in server.env
OSEYE_DB_PASSWORD=CHANGE_ME

# ── Threat Intelligence API keys (optional) ──────────────────────────────────
# Leave empty to disable a provider
OSEYE_ABUSEIPDB_API_KEY=
OSEYE_VIRUSTOTAL_API_KEY=
OSEYE_MISP_URL=
OSEYE_MISP_API_KEY=
