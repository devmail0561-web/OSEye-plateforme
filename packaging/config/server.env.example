# OSEye Server — Environment Configuration
# Copy to /etc/oseye/server.env before starting the server.
# Sensitive values (passwords, API keys) go in secrets.env — not here.
# Both files are loaded by the systemd unit (EnvironmentFile).
# For interactive setup: sudo oseye-server setup

# ── Database ─────────────────────────────────────────────────────────────────
# sqlite = embedded (zero dependency), postgresql = production
OSEYE_DB_BACKEND=sqlite
OSEYE_DB_URL=sqlite+aiosqlite:///var/lib/oseye/server/oseye.db
# For PostgreSQL, set in secrets.env:
#   OSEYE_DB_URL=postgresql+asyncpg://oseye:PASSWORD@localhost:5432/oseye
OSEYE_DB_POOL_SIZE=10
OSEYE_DB_MAX_OVERFLOW=20

# ── Redis (event bus) ─────────────────────────────────────────────────────────
# Leave empty for in-memory bus (single-node, no external dependency)
# Set for production multi-process: redis://localhost:6379/0
OSEYE_REDIS_URL=

# ── gRPC ──────────────────────────────────────────────────────────────────────
OSEYE_GRPC_PORT=50051
OSEYE_GRPC_MAX_WORKERS=10

# ── API ───────────────────────────────────────────────────────────────────────
OSEYE_API_PORT=8000
OSEYE_API_HOST=0.0.0.0
# JSON array of allowed CORS origins (update with your UI URL)
OSEYE_API_CORS_ORIGINS=["https://your-ui-hostname"]

# ── TLS / PKI ────────────────────────────────────────────────────────────────
OSEYE_TLS_CERT_FILE=/etc/oseye/certs/server.crt
OSEYE_TLS_KEY_FILE=/etc/oseye/certs/server.key
OSEYE_TLS_CA_CERT_FILE=/etc/oseye/certs/ca.crt
# CA private key — used by the enrollment endpoint to sign agent certificates
OSEYE_TLS_CA_KEY_FILE=/etc/oseye/certs/ca.key
# Directory containing authorized agent public keys (Ed25519, one file per agent)
OSEYE_AGENT_KEYS_DIR=/etc/oseye/agent_keys

# ── JWT (RS256) ───────────────────────────────────────────────────────────────
OSEYE_JWT_PRIVATE_KEY_PATH=/etc/oseye/certs/jwt_private.pem
OSEYE_JWT_PUBLIC_KEY_PATH=/etc/oseye/certs/jwt_public.pem
OSEYE_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
OSEYE_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Observability ─────────────────────────────────────────────────────────────
OSEYE_LOG_LEVEL=INFO
OSEYE_SERVICE_NAME=oseye-server
# Uncomment to enable OpenTelemetry export
# OSEYE_OTEL_ENDPOINT=localhost:4317

# ── Workers ───────────────────────────────────────────────────────────────────
OSEYE_BATCH_FLUSH_INTERVAL_MS=500
OSEYE_BATCH_MAX_SIZE=500

# ── Enrollment ────────────────────────────────────────────────────────────────
# Directory where enrollment token files are stored (one file per token)
OSEYE_ENROLLMENT_TOKEN_DIR=/etc/oseye/enrollment_tokens

# ── Threat Intelligence ───────────────────────────────────────────────────────
OSEYE_TI_CACHE_TTL_SECONDS=3600
OSEYE_TI_LOOKUP_TIMEOUT_SECONDS=5.0
OSEYE_TI_BREAKER_FAIL_MAX=5
OSEYE_TI_BREAKER_RESET_TIMEOUT=60.0

# ── Correlation ───────────────────────────────────────────────────────────────
OSEYE_CORRELATION_WINDOW_SECONDS=300
OSEYE_CORRELATION_MIN_SEVERITY=medium

# ── Decision Engine ───────────────────────────────────────────────────────────
OSEYE_DECISION_HUMAN_TIMEOUT_SECS=3600
OSEYE_DECISION_HUMAN_POLL_INTERVAL=30
OSEYE_DECISION_POLICY_VERSION=v1.0

# ── Production guard ─────────────────────────────────────────────────────────
# Setting OSEYE_ENV=production enforces strong passwords and disables API docs
OSEYE_ENV=production

# ── UI ────────────────────────────────────────────────────────────────────────
# UI intégrée (optionnel — laisser vide pour mode API-only)
# URL du serveur UI (CORS auto-configuré + redirect GET / → UI)
# Exemples : https://ui.example.com  ou  http://localhost:5173
OSEYE_UI_URL=

# Répertoire dist de l'UI si elle est servie par CE serveur (optionnel)
OSEYE_UI_DIR=

# Données JWT blocklist (défaut: /tmp — changer en prod)
OSEYE_DATA_DIR=/var/lib/oseye

# ── Plugin ────────────────────────────────────────────────────────────────────
OSEYE_PLUGIN_REQUIRE_SIGNATURE=true
OSEYE_PLUGIN_STRICT_NETNS=false

# ── ML ────────────────────────────────────────────────────────────────────────
OSEYE_ML_CHECKPOINT_PATH=/var/lib/oseye/ml_checkpoint.pkl
OSEYE_ML_CHECKPOINT_INTERVAL_S=300

# ── Surveillance ──────────────────────────────────────────────────────────────
OSEYE_DEFAULT_SURVEILLANCE_PROFILE=workstation
