# OSEye Agent — Environment Configuration
# Copy to /etc/oseye/agent.env and set values before starting oseye-agent.
# This file is loaded by the systemd unit via EnvironmentFile=.
# Generated automatically by enroll-agent.sh — edit manually only if needed.

# ── gRPC Transport ──────────────────────────────────────────────────────────
# Address of the OSEye server gRPC endpoint (host:port)
OSEYE_GRPC_ADDR=your-server-hostname:50051

# ── mTLS Certificates ───────────────────────────────────────────────────────
# Paths set automatically by enroll-agent.sh
OSEYE_TLS_CERT=/etc/oseye/certs/agent.crt
OSEYE_TLS_KEY=/etc/oseye/certs/agent.key
OSEYE_TLS_CA=/etc/oseye/certs/ca.crt

# ── Agent Identity ───────────────────────────────────────────────────────────
# UUID v4 uniquely identifying this agent (auto-generated if empty)
OSEYE_AGENT_ID=

# ── Offline Buffer ───────────────────────────────────────────────────────────
# SQLite file used to buffer events when the server is unreachable
OSEYE_BUFFER_PATH=/var/lib/oseye/buffer.db

# ── Event Batching ───────────────────────────────────────────────────────────
# Number of events per gRPC batch
OSEYE_BATCH_SIZE=1000
# Batch flush timeout in milliseconds
OSEYE_BATCH_TIMEOUT_MS=1000

# ── Resource Watchdog ────────────────────────────────────────────────────────
# Maximum CPU usage percentage before throttling collectors (0 = unlimited)
OSEYE_MAX_CPU_PCT=4.0
# Maximum memory usage in megabytes before throttling
OSEYE_MAX_MEM_MB=256

# ── Collector Configuration ──────────────────────────────────────────────────
# Comma-separated list of paths monitored by fanotify (file access events)
OSEYE_FANOTIFY_PATHS=/etc/passwd,/etc/shadow,/root/.ssh

# JSON array of inotify watches
# Each watch: {"path": "<dir>", "recursive": <bool>, "mask": <int>}
# mask 4095 = IN_ALL_EVENTS
OSEYE_INOTIFY_WATCHES=[{"path":"/tmp","recursive":false,"mask":4095}]

# Journald minimum priority filter (empty = all messages)
# Values: emerg | alert | crit | err | warning | notice | info | debug
OSEYE_JOURNALD_PRIORITY=

# Comma-separated list of systemd units to monitor (empty = all units)
OSEYE_JOURNALD_UNITS=

# Local syslog listener address (host:port)
OSEYE_SYSLOG_ADDR=127.0.0.1:514
