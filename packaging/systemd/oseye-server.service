[Unit]
Description=OSEye Server — Analysis Engine & API
Documentation=https://github.com/devmail0561-web/OSEye-plateforme
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oseye-srv
Group=oseye-srv
EnvironmentFile=-/etc/oseye/server.env
EnvironmentFile=-/etc/oseye/secrets.env
ExecStart=/usr/bin/oseye-server start
ExecStop=/usr/bin/oseye-server stop
ExecReload=/usr/bin/oseye-server restart
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/oseye/server /etc/oseye /var/lib/oseye
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
