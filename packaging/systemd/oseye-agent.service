[Unit]
Description=OSEye EDR Agent
Documentation=https://github.com/oseye/oseye
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=oseye-agt
Group=oseye-agt

# eBPF requires elevated capabilities.
# Linux >= 5.8 (Debian 11+, Ubuntu 20.10+, RHEL 9+):
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_SYS_PTRACE
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_SYS_PTRACE
# Linux < 5.8 (RHEL 8 with stock kernel): replace the two lines above with:
#   CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SYS_PTRACE
#   AmbientCapabilities=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SYS_PTRACE

NoNewPrivileges=true
EnvironmentFile=-/etc/oseye/agent.env
ExecStart=/usr/bin/oseye-agent
Restart=on-failure
RestartSec=5s
MemoryMax=512M
CPUQuota=10%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oseye-agent

[Install]
WantedBy=multi-user.target
