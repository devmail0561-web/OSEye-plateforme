#!/bin/sh
set -e

# Répertoires agent — accessibles uniquement par oseye-agt
install -d -m 750 /etc/oseye
chown root:oseye-agt /etc/oseye
install -d -m 700 /etc/oseye/certs
chown oseye-agt:oseye-agt /etc/oseye/certs
install -d -m 750 /var/lib/oseye/agent
chown oseye-agt:oseye-agt /var/lib/oseye/agent

# agent.env lisible uniquement par oseye-agt
if [ -f /etc/oseye/agent.env.example ] && [ ! -f /etc/oseye/agent.env ]; then
    cp /etc/oseye/agent.env.example /etc/oseye/agent.env
fi
chmod 640 /etc/oseye/agent.env 2>/dev/null || true
chown root:oseye-agt /etc/oseye/agent.env 2>/dev/null || true

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload
    systemctl enable oseye-agent
    echo ""
    echo "OSEye agent installé."
    echo "  Enroller l'agent : oseye-config enroll --server <HOST>:50051 --token <TOKEN>"
    echo "  Le service démarre automatiquement après l'enrollment."
fi
