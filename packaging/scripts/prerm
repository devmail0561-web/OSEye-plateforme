#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "0" ]; then
    if systemctl is-active --quiet oseye-agent 2>/dev/null; then
        echo "Stopping oseye-agent..."
        systemctl stop oseye-agent
    fi
    if systemctl is-enabled --quiet oseye-agent 2>/dev/null; then
        systemctl disable oseye-agent
    fi
fi
