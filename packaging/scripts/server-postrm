#!/bin/sh
set -e

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload 2>/dev/null || true
fi

if [ "$1" = "purge" ]; then
    rm -rf /var/lib/oseye/server
    rm -f /etc/oseye/server.env /etc/oseye/secrets.env

    # oseye-srv est propre à oseye-server — supprimer sans condition croisée.
    # oseye-agt (agent) et oseye-dev (dev) ont leurs propres users distincts.
    if getent passwd oseye-srv >/dev/null; then
        userdel oseye-srv 2>/dev/null || true
    fi
    if getent group oseye-srv >/dev/null; then
        groupdel oseye-srv 2>/dev/null || true
    fi
fi
