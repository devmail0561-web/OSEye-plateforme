<!-- ARCHITECTURE -->
<section style="padding-top:0">
  <div class="section-tag">Architecture</div>
  <h2>Lightweight by design</h2>
  <p class="section-sub">
    A static Go binary on each host, a Python server you control. No SaaS, no telemetry sent to third parties.
  </p>
  <div class="arch-wrap">
    <div class="arch-flow">
      <div class="arch-box">
        <div class="arch-box-title">Agent — Go static binary</div>
        <div class="arch-item"><div class="arch-item-dot" style="background:#00d4ff"></div>eBPF · auditd · fanotify</div>
        <div class="arch-item"><div class="arch-item-dot" style="background:#00d4ff"></div>inotify · procfs · netlink</div>
        <div class="arch-item"><div class="arch-item-dot" style="background:#00d4ff"></div>journald · udev · syslog</div>
        <div class="arch-item" style="margin-top:.6rem"><div class="arch-item-dot" style="background:#4ade80"></div>SQLite offline buffer</div>
        <div class="arch-item"><div class="arch-item-dot" style="background:#ef4444"></div>Response: kill / block / quarantine</div>
        <div style="margin-top:.8rem; font-size:.75rem; color:var(--faint)">
          .deb · .rpm · Docker · systemd
