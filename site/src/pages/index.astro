<!-- QUICK START -->
<section style="padding-top:0">
  <div class="section-tag">Quick Start</div>
  <h2>Up and running in minutes</h2>
  <p class="section-sub">One command to install the agent. Docker Compose for the server. No external SaaS required.</p>
  <div class="qstart-grid">
    <div class="code-block">
      <div class="code-header">
        <span class="code-title">Deploy the server</span>
        <span class="code-lang">bash</span>
      </div>
      <pre><span class="c"># Clone and start with Docker Compose</span>
git clone https://github.com/devmail0561-web/OSEye-plateforme.git
cd oseye
sudo bash scripts/init-server.sh

docker compose \
  -f infra/docker/docker-compose.prod.yml \
  up -d

<span class="c"># Server is now at :8000 (API) + :50051 (gRPC)</span></pre>
    </div>
    <div class="code-block">
      <div class="code-header">
        <span class="code-title">Enroll an agent</span>
        <span class="code-lang">bash</span>
      </div>
      <pre><span class="c"># Install the agent (Debian/Ubuntu)</span>
curl -fsSL https://devmail0561-web.github.io/OSEye-plateforme/install.sh \
  | sudo bash

<span class="c"># Point it at your server</span>
sudo oseye-config set \
  <span class="v">OSEYE_GRPC_ADDR</span>=<span class="s">server.example.com:50051</span>

sudo systemctl start oseye-agent
sudo oseye-config validate</pre>
    </div>
  </div>
</section>

