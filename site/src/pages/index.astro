---
import { ViewTransitions } from 'astro:transitions';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>OSEye — Open-Source EDR/SIEM</title>
  <ViewTransitions />
  <meta name="description" content="OSEye is an open-source EDR/SIEM. eBPF-native telemetry on Linux today; Windows, macOS, Android, iOS and FreeBSD on the roadmap. Single binary, zero vendor lock-in." />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:        #07090e;
      --surface:   #0d1117;
      --surface2:  #111820;
      --border:    #1e2836;
      --border2:   #263040;
      --cyan:      #00d4ff;
      --cyan-dim:  #0098b8;
      --green:     #4ade80;
      --amber:     #f59e0b;
      --red:       #ef4444;
      --text:      #e6edf3;
      --muted:     #7d8590;
      --faint:     #3a4555;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      font-size: 16px;
      line-height: 1.6;
      overflow-x: hidden;
    }

    a { color: inherit; text-decoration: none; }

    /* ── NAV ─────────────────────────────────────────── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 2rem;
      height: 60px;
      background: rgba(7,9,14,.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }
    .nav-logo {
      display: flex; align-items: center; gap: .6rem;
      font-weight: 700; font-size: 1.15rem; letter-spacing: -.01em;
    }
    .nav-logo svg { width: 28px; height: 28px; color: var(--cyan); }
    .nav-links { display: flex; align-items: center; gap: 1.6rem; }
    .nav-links a { color: var(--muted); font-size: .9rem; transition: color .2s; }
    .nav-links a:hover { color: var(--text); }
    .nav-cta {
      background: var(--cyan); color: #000;
      font-size: .85rem; font-weight: 600;
      padding: .45rem 1.1rem; border-radius: 6px;
      transition: opacity .2s;
    }
    .nav-cta:hover { opacity: .85; }

    /* ── HERO ────────────────────────────────────────── */
    .hero {
      min-height: 100vh;
      display: grid; grid-template-columns: 1fr 1fr;
      align-items: center; gap: 3rem;
      padding: 6rem 4rem 4rem;
      max-width: 1280px; margin: 0 auto;
      position: relative;
    }
    .hero-bg {
      position: fixed; inset: 0; pointer-events: none; z-index: 0;
      background:
        radial-gradient(ellipse 60% 50% at 15% 40%, rgba(0,212,255,.07) 0%, transparent 60%),
        radial-gradient(ellipse 40% 40% at 80% 70%, rgba(74,222,128,.04) 0%, transparent 50%);
    }
    .hero-grid {
      position: fixed; inset: 0; pointer-events: none; z-index: 0;
      background-image:
        linear-gradient(rgba(30,40,54,.35) 1px, transparent 1px),
        linear-gradient(90deg, rgba(30,40,54,.35) 1px, transparent 1px);
      background-size: 40px 40px;
      mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 0%, transparent 100%);
    }
    .hero-text { position: relative; z-index: 1; }
    .hero-badge {
      display: inline-flex; align-items: center; gap: .4rem;
      background: rgba(0,212,255,.08); border: 1px solid rgba(0,212,255,.25);
      color: var(--cyan); font-size: .78rem; font-weight: 600;
      letter-spacing: .06em; text-transform: uppercase;
      padding: .3rem .8rem; border-radius: 20px;
      margin-bottom: 1.4rem;
    }
    .hero-badge-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--cyan);
      box-shadow: 0 0 6px var(--cyan);
      animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }

    h1 {
      font-size: clamp(2.4rem, 5vw, 3.8rem);
      font-weight: 800; line-height: 1.1;
      letter-spacing: -.03em;
      margin-bottom: 1.2rem;
    }
    h1 .accent { color: var(--cyan); }
    .hero-sub {
      font-size: 1.1rem; color: var(--muted); line-height: 1.7;
      max-width: 520px; margin-bottom: 2rem;
    }
    .hero-sub strong { color: var(--text); font-weight: 500; }
    .hero-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .btn-primary {
      display: inline-flex; align-items: center; gap: .5rem;
      background: var(--cyan); color: #000;
      font-weight: 700; font-size: .95rem;
      padding: .75rem 1.6rem; border-radius: 8px;
      transition: all .2s;
    }
    .btn-primary:hover { background: #26dbff; transform: translateY(-1px); }
    .btn-secondary {
      display: inline-flex; align-items: center; gap: .5rem;
      background: transparent; color: var(--text);
      border: 1px solid var(--border2); font-weight: 500; font-size: .95rem;
      padding: .75rem 1.6rem; border-radius: 8px;
      transition: all .2s;
    }
    .btn-secondary:hover { border-color: var(--faint); background: rgba(255,255,255,.04); }

    /* ── TERMINAL MOCKUP ─────────────────────────────── */
    .hero-terminal {
      position: relative; z-index: 1;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 24px 80px rgba(0,0,0,.5), 0 0 0 1px rgba(0,212,255,.06);
    }
    .terminal-bar {
      background: var(--surface2);
      padding: .6rem 1rem;
      display: flex; align-items: center; gap: .5rem;
      border-bottom: 1px solid var(--border);
    }
    .terminal-dot {
      width: 12px; height: 12px; border-radius: 50%;
    }
    .terminal-title {
      margin-left: .4rem; font-size: .78rem; color: var(--muted);
      font-family: monospace;
    }
    .terminal-body {
      padding: 1.2rem 1.4rem;
      font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
      font-size: .8rem; line-height: 1.8;
    }
    .t-dim    { color: var(--faint); }
    .t-muted  { color: var(--muted); }
    .t-text   { color: var(--text); }
    .t-cyan   { color: var(--cyan); }
    .t-green  { color: var(--green); }
    .t-amber  { color: var(--amber); }
    .t-red    { color: var(--red); }
    .t-label  {
      display: inline-block; padding: .1rem .5rem; border-radius: 4px;
      font-size: .72rem; font-weight: 700; letter-spacing: .05em;
    }
    .label-crit  { background: rgba(239,68,68,.15); color: var(--red); }
    .label-warn  { background: rgba(245,158,11,.12); color: var(--amber); }
    .label-ok    { background: rgba(74,222,128,.1); color: var(--green); }

    /* ── STATS ───────────────────────────────────────── */
    .stats {
      background: var(--surface);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .stats-inner {
      max-width: 1280px; margin: 0 auto;
      display: grid; grid-template-columns: repeat(4,1fr);
      padding: 0 4rem;
    }
    .stat-item {
      padding: 2rem 1.5rem;
      border-right: 1px solid var(--border);
      text-align: center;
    }
    .stat-item:last-child { border-right: none; }
    .stat-num {
      font-size: 2.4rem; font-weight: 800;
      color: var(--cyan); letter-spacing: -.04em;
      font-variant-numeric: tabular-nums;
    }
    .stat-label {
      font-size: .82rem; color: var(--muted);
      margin-top: .2rem; letter-spacing: .02em;
    }

    /* ── SECTIONS ────────────────────────────────────── */
    section { padding: 6rem 4rem; max-width: 1280px; margin: 0 auto; }

    .section-tag {
      font-size: .75rem; font-weight: 700;
      color: var(--cyan); letter-spacing: .1em;
      text-transform: uppercase; margin-bottom: .8rem;
    }
    h2 {
      font-size: clamp(1.8rem, 3vw, 2.6rem);
      font-weight: 800; letter-spacing: -.03em;
      line-height: 1.15; margin-bottom: 1rem;
    }
    .section-sub {
      font-size: 1.05rem; color: var(--muted); max-width: 540px;
      line-height: 1.7; margin-bottom: 3rem;
    }

    /* ── HOW IT WORKS ────────────────────────────────── */
    .how-grid {
      display: grid; grid-template-columns: repeat(3,1fr); gap: 1px;
      background: var(--border);
      border: 1px solid var(--border); border-radius: 12px;
      overflow: hidden;
    }
    .how-item {
      background: var(--surface);
      padding: 2.4rem 2rem;
    }
    .how-num {
      font-size: .7rem; font-weight: 700; color: var(--cyan);
      letter-spacing: .1em; text-transform: uppercase;
      margin-bottom: 1rem;
    }
    .how-icon {
      width: 44px; height: 44px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 1rem;
    }
    .how-icon svg { width: 22px; height: 22px; }
    .how-title {
      font-size: 1.15rem; font-weight: 700;
      margin-bottom: .6rem;
    }
    .how-desc { font-size: .9rem; color: var(--muted); line-height: 1.6; }
    .how-tags { margin-top: .8rem; display: flex; gap: .4rem; flex-wrap: wrap; }
    .tag {
      font-size: .72rem; padding: .2rem .6rem; border-radius: 4px;
      border: 1px solid var(--border2); color: var(--muted);
    }

    /* ── FEATURES ────────────────────────────────────── */
    .features-grid {
      display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem;
    }
    .feature-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px; padding: 1.8rem;
      transition: border-color .2s, transform .2s;
    }
    .feature-card:hover { border-color: var(--border2); transform: translateY(-2px); }
    .feature-icon {
      width: 40px; height: 40px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 1rem;
    }
    .feature-icon svg { width: 20px; height: 20px; }
    .feature-title { font-size: 1rem; font-weight: 700; margin-bottom: .4rem; }
    .feature-desc { font-size: .87rem; color: var(--muted); line-height: 1.6; }

    /* ── ARCHITECTURE ────────────────────────────────── */
    .arch-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px; padding: 2.5rem;
    }
    .arch-flow {
      display: grid;
      grid-template-columns: 1fr 80px 1fr;
      align-items: start;
      gap: 0;
    }
    .arch-box {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 10px; padding: 1.4rem;
    }
    .arch-box-title {
      font-size: .75rem; font-weight: 700;
      letter-spacing: .08em; text-transform: uppercase;
      color: var(--cyan); margin-bottom: 1rem;
      padding-bottom: .6rem; border-bottom: 1px solid var(--border);
    }
    .arch-item {
      display: flex; align-items: center; gap: .5rem;
      font-size: .82rem; color: var(--muted);
      padding: .3rem 0;
    }
    .arch-item-dot {
      width: 6px; height: 6px; border-radius: 50%;
      flex-shrink: 0;
    }
    .arch-arrow {
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding-top: 4.5rem; gap: .3rem;
    }
    .arch-arrow-line {
      width: 100%; height: 1px;
      background: linear-gradient(90deg, var(--border) 0%, var(--cyan-dim) 50%, var(--border) 100%);
      position: relative;
    }
    .arch-arrow-label {
      font-size: .68rem; color: var(--cyan-dim); letter-spacing: .05em;
      white-space: nowrap;
    }

    /* ── QUICK START ─────────────────────────────────── */
    .qstart-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;
    }
    .code-block {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px; overflow: hidden;
    }
    .code-header {
      background: var(--surface2);
      padding: .7rem 1.2rem;
      display: flex; align-items: center; justify-content: space-between;
      border-bottom: 1px solid var(--border);
    }
    .code-title { font-size: .8rem; font-weight: 600; color: var(--muted); }
    .code-lang {
      font-size: .7rem; color: var(--faint);
      font-family: monospace; letter-spacing: .05em;
    }
    pre {
      padding: 1.2rem 1.4rem;
      font-family: 'SF Mono', 'Fira Code', monospace;
      font-size: .8rem; line-height: 1.8;
      overflow-x: auto;
      color: var(--text);
    }
    pre .c   { color: var(--faint); }
    pre .k   { color: var(--cyan); }
    pre .s   { color: var(--green); }
    pre .v   { color: var(--amber); }

    /* ── CTA BAND ────────────────────────────────────── */
    .cta-band {
      background: var(--surface);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .cta-inner {
      max-width: 1280px; margin: 0 auto;
      padding: 5rem 4rem;
      display: flex; align-items: center; justify-content: space-between;
      gap: 2rem; flex-wrap: wrap;
    }
    .cta-text h2 { margin-bottom: .5rem; }
    .cta-text p { color: var(--muted); font-size: 1rem; }
    .cta-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

    /* ── FOOTER ──────────────────────────────────────── */
    footer {
      max-width: 1280px; margin: 0 auto;
      padding: 3rem 4rem;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 1.5rem;
    }
    .footer-logo { font-weight: 700; font-size: .95rem; color: var(--text); }
    .footer-links { display: flex; gap: 1.6rem; flex-wrap: wrap; }
    .footer-links a { font-size: .85rem; color: var(--muted); transition: color .2s; }
    .footer-links a:hover { color: var(--text); }
    .footer-right { font-size: .8rem; color: var(--faint); }

    /* ── PLATFORM ROADMAP ───────────────────────────── */
    .roadmap-timeline {
      display: flex; align-items: flex-start;
      gap: 0; margin-bottom: 3rem; position: relative;
    }
    .roadmap-phase {
      flex: 1; display: flex; flex-direction: column; align-items: center;
      position: relative; text-align: center;
    }
    .roadmap-phase-track {
      display: flex; align-items: center; width: 100%; position: relative;
      margin-bottom: 1.2rem;
    }
    .roadmap-phase-dot {
      width: 16px; height: 16px; border-radius: 50%;
      flex-shrink: 0; position: relative; z-index: 1;
    }
    .roadmap-phase-dot.active {
      background: var(--green);
      box-shadow: 0 0 10px rgba(74,222,128,.5);
    }
    .roadmap-phase-dot.indev {
      background: var(--surface);
      border: 2px solid var(--amber);
      box-shadow: 0 0 8px rgba(245,158,11,.3);
    }
    .roadmap-phase-dot.indev::after {
      content: ''; position: absolute; inset: 3px; border-radius: 50%;
      background: var(--amber); opacity: .5;
    }
    .roadmap-phase-dot.planned {
      background: var(--surface);
      border: 2px solid var(--faint);
    }
    .roadmap-connector {
      flex: 1; height: 1px; margin: 0 -1px;
    }
    .roadmap-connector.active-to-indev {
      background: linear-gradient(90deg, var(--green) 0%, var(--amber) 100%);
    }
    .roadmap-connector.indev-to-planned {
      background: linear-gradient(90deg, var(--amber) 0%, var(--faint) 100%);
    }
    .roadmap-phase-label {
      font-size: .72rem; font-weight: 700; letter-spacing: .06em;
      text-transform: uppercase; margin-bottom: .3rem;
    }
    .roadmap-phase-label.active  { color: var(--green); }
    .roadmap-phase-label.indev   { color: var(--amber); }
    .roadmap-phase-label.planned { color: var(--faint); }
    .roadmap-phase-title {
      font-size: .95rem; font-weight: 700; margin-bottom: .2rem;
    }
    .roadmap-phase-desc {
      font-size: .8rem; color: var(--muted); line-height: 1.5;
    }

    .platform-grid {
      display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem;
    }
    .platform-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px; padding: 1.6rem;
      transition: border-color .2s, transform .2s;
      display: flex; flex-direction: column; gap: 1rem;
    }
    .platform-card.active  { border-color: rgba(74,222,128,.2); }
    .platform-card.indev   { border-color: rgba(245,158,11,.18); }
    .platform-card.planned { opacity: .65; }
    .platform-card:hover { transform: translateY(-2px); }
    .platform-card.active:hover  { border-color: rgba(74,222,128,.4); }
    .platform-card.indev:hover   { border-color: rgba(245,158,11,.35); }
    .platform-card.planned:hover { opacity: .9; border-color: var(--border2); }

    .platform-header {
      display: flex; align-items: center; justify-content: space-between; gap: .8rem;
    }
    .platform-name-wrap {
      display: flex; align-items: center; gap: .8rem;
    }
    .platform-icon {
      width: 36px; height: 36px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .platform-icon svg { width: 20px; height: 20px; }
    .platform-name { font-size: 1rem; font-weight: 700; }
    .platform-badge {
      font-size: .68rem; font-weight: 700;
      letter-spacing: .06em; text-transform: uppercase;
      padding: .2rem .6rem; border-radius: 4px;
      white-space: nowrap;
    }
    .badge-active  { background: rgba(74,222,128,.1);  color: var(--green); }
    .badge-indev   { background: rgba(245,158,11,.1);  color: var(--amber); }
    .badge-planned { background: rgba(58,69,85,.3);    color: var(--faint); }

    .platform-collectors {
      font-size: .8rem; color: var(--muted); line-height: 1.6;
    }
    .platform-collectors strong { color: var(--text); font-weight: 600; font-size: .75rem; display: block; margin-bottom: .3rem; letter-spacing: .04em; text-transform: uppercase; }
    .platform-tech-list {
      display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .4rem;
    }
    .platform-tech {
      font-size: .7rem; padding: .15rem .5rem; border-radius: 4px;
      border: 1px solid var(--border2); color: var(--muted);
      font-family: 'SF Mono', 'Fira Code', monospace;
    }
    .platform-note {
      font-size: .78rem; color: var(--faint);
      border-top: 1px solid var(--border);
      padding-top: .8rem; margin-top: auto;
      display: flex; align-items: center; gap: .4rem;
    }
    .platform-note-dot {
      width: 5px; height: 5px; border-radius: 50%; flex-shrink: 0;
    }

    /* ── RESPONSIVE ──────────────────────────────────── */
    @media (max-width: 1024px) {
      .hero { grid-template-columns: 1fr; gap: 2rem; padding: 6rem 2rem 3rem; }
      .stats-inner { grid-template-columns: repeat(2,1fr); padding: 0 2rem; }
      .stat-item:nth-child(2) { border-right: none; }
      .how-grid { grid-template-columns: 1fr; }
      .features-grid { grid-template-columns: repeat(2,1fr); }
      .platform-grid { grid-template-columns: repeat(2,1fr); }
      .roadmap-phase-desc { display: none; }
      .arch-flow { grid-template-columns: 1fr; gap: 1rem; }
      .arch-arrow { flex-direction: row; padding-top: 0; padding-left: 1rem; }
      .qstart-grid { grid-template-columns: 1fr; }
      section { padding: 4rem 2rem; }
      .cta-inner { padding: 4rem 2rem; }
      footer { padding: 2rem; }
    }
    @media (max-width: 640px) {
      .nav-links { display: none; }
      .features-grid { grid-template-columns: 1fr; }
      .platform-grid { grid-template-columns: 1fr; }
      .stats-inner { grid-template-columns: 1fr 1fr; }
      .roadmap-timeline { gap: .5rem; }
      .roadmap-connector { min-width: 20px; }
    }
  </style>
</head>
<body>

<div class="hero-bg"></div>
<div class="hero-grid"></div>

<!-- NAV -->
<nav>
  <a href={`${base}/`} class="nav-logo">
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="32" cy="32" r="28" stroke="currentColor" stroke-width="3"/>
      <circle cx="32" cy="32" r="12" fill="currentColor" opacity="0.15"/>
      <circle cx="32" cy="32" r="5" fill="currentColor"/>
      <path d="M32 4 L32 12 M32 52 L32 60 M4 32 L12 32 M52 32 L60 32" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <path d="M12 12 L18 18 M46 46 L52 52 M52 12 L46 18 M18 46 L12 52" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
    </svg>
    OSEye
  </a>
  <div class="nav-links">
    <a href={`${base}/getting-started/installation/`}>Docs</a>
    <a href={`${base}/reference/architecture/`}>Architecture</a>
    <a href={`${base}/download/`}>Download</a>
    <a href="https://github.com/devmail0561-web/OSEye-plateforme">GitHub</a>
    <a href={`${base}/getting-started/installation/`} class="nav-cta">Get Started</a>
  </div>
</nav>

<!-- HERO -->
<div class="hero">
  <div class="hero-text">
    <div class="hero-badge">
      <div class="hero-badge-dot"></div>
      Open-source · Cross-platform EDR/SIEM
    </div>
    <h1>See Everything.<br/><span class="accent">Respond Instantly.</span></h1>
    <p class="hero-sub">
      OSEye is an <strong>open-source EDR/SIEM for Linux</strong> built on eBPF-native telemetry.
      Detect threats in real time, trigger autonomous responses, and keep full control of your security data —
      no vendor lock-in, no cloud dependency.
    </p>
