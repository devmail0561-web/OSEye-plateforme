# OSEye — variables d'environnement de développement
# Copier ce fichier en .env et adapter les valeurs

# Agent
OSEYE_GRPC_ADDR=localhost:50051
OSEYE_TLS_CERT=/etc/oseye/certs/agent.crt
OSEYE_TLS_KEY=/etc/oseye/certs/agent.key
OSEYE_TLS_CA=/etc/oseye/certs/ca.crt
OSEYE_BUFFER_PATH=/var/lib/oseye/buffer.db
OSEYE_AGENT_ID=
OSEYE_BATCH_SIZE=1000
OSEYE_BATCH_TIMEOUT_MS=1000
OSEYE_MAX_CPU_PCT=4.0
OSEYE_MAX_MEM_MB=256
OSEYE_LOG_LEVEL=INFO

# Server
OSEYE_DB_BACKEND=sqlite
OSEYE_DB_URL=sqlite+aiosqlite:///./oseye_dev.db
OSEYE_DB_POOL_SIZE=10
OSEYE_DB_MAX_OVERFLOW=20
OSEYE_REDIS_URL=redis://localhost:6379/0
OSEYE_GRPC_PORT=50051
OSEYE_GRPC_MAX_WORKERS=10
OSEYE_API_PORT=8000
OSEYE_API_HOST=0.0.0.0
OSEYE_API_CORS_ORIGINS=["http://localhost:5173"]
OSEYE_TLS_CERT_FILE=/etc/oseye/certs/server.crt
OSEYE_TLS_KEY_FILE=/etc/oseye/certs/server.key
OSEYE_TLS_CA_CERT_FILE=/etc/oseye/certs/ca.crt
OSEYE_JWT_PRIVATE_KEY_PATH=/etc/oseye/certs/jwt_private.pem
OSEYE_JWT_PUBLIC_KEY_PATH=/etc/oseye/certs/jwt_public.pem
OSEYE_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
OSEYE_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# REQUIRED: HMAC secret for API key hashing (min 32 chars)
OSEYE_SECRET_KEY=CHANGE_ME_RANDOM_32_CHARS_MINIMUM
# REQUIRED in production: directory for JWT blocklist (not /tmp)
OSEYE_DATA_DIR=/var/lib/oseye
# Optional: passphrase for the CA private key if encrypted
OSEYE_TLS_CA_KEY_PASSWORD=
OSEYE_LOG_LEVEL=INFO
OSEYE_OTEL_ENDPOINT=
OSEYE_SERVICE_NAME=oseye-server
OSEYE_BATCH_FLUSH_INTERVAL_MS=500
OSEYE_BATCH_MAX_SIZE=500

# Threat Intelligence (optionnel)
OSEYE_ABUSEIPDB_API_KEY=
OSEYE_VIRUSTOTAL_API_KEY=
OSEYE_MISP_URL=
OSEYE_MISP_API_KEY=
